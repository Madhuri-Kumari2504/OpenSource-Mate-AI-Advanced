PORT=8000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# Optional; public GitHub access does not require a token. Never commit a real token.
GITHUB_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set in frontend/.env.local only if the API is not served via the Vite /api proxy:
# VITE_API_BASE_URL=https://your-backend.example
# Set in frontend/.env.local to change the Vite proxy target:
# BACKEND_URL=http://localhost:8000
