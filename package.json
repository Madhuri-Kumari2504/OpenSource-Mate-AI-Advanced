{
  "name": "opensource-mate-ai",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend -- --port 5174",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}